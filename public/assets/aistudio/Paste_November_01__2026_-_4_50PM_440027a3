  export function generateLinkedDocumentRef(

    baseRef: string,

    docType: DocumentType,

    existingCount: number = 0

  ): string {

    const prefixMap: Record<DocumentType, string> = {

      quotation: 'QT',

      delivery_note: 'DO',

      purchase_order: 'PO',

      receipt: 'REC',

      payment_voucher: 'PV',

      material_return_note: 'MRN',

      debit_note: 'DN',

    };

    const prefix = prefixMap[docType] || 'DOC';

    const rawClean = String(baseRef || '')

      .trim()

      .replace(/-R\d+$/i, '')

      .replace(/^(QT|DO|PO|REC|LPO|PI|INV)[-_/\s]*/i, ''); // <--- BUG: Missing PV, MRN, DN

    const coreBase = rawClean || 'DOC';

    const seqStr = String(existingCount + 1).padStart(2, '0');

    return `${prefix}-${coreBase}-${seqStr}`;

  }

  ```

When `baseRef` is `PV-0002`, the regex does not strip `PV-`. Therefore `coreBase` remains `PV-0002`, producing `PO-PV-0002-01`, `REC-PV-0002-01`, and `MRN-PV-0002-01`.


